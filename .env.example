# Competitor Blog Spy & Real-Time Content Monitoring System
PROJECT_NAME="Competitor Blog Spy & Real-Time Content Monitoring System"
VERSION="1.0.0"

# Database connection (SQLite default, can be switched to PostgreSQL: postgresql://user:pass@localhost:5432/blogspy)
DATABASE_URL="sqlite:///./blog_spy.db"

# Background Monitoring Configuration
DEFAULT_MONITORING_INTERVAL_MINUTES=5
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
CONCURRENT_WORKERS=10
USER_AGENT="CompetitorBlogSpyBot/1.0 (+https://competitorblogspy.internal/bot; research@example.com)"

# Email Notification Settings (Optional)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
ALERT_EMAIL_RECIPIENT=""

# Demo Configuration
DEMO_MODE=true
DEMO_SITE_URL="http://127.0.0.1:8001"
